# Single source of truth for tool and service versions.
# Read by CI (GitHub Actions), Docker Compose (--env-file) and benchmark tooling.
# Keep global.json (DOTNET_SDK) and src/Opportunity.Web/.nvmrc (NODE major) in sync; CI verifies this.
DOTNET_SDK=10.0.100
NODE=24
POSTGRES=17
OPENSEARCH=3.2.0
RABBITMQ=4.1
# Object-store contract suite images (E19-T01). SeaweedFS: Apache-2.0 (Q-38); Azurite: MIT. Bundled-store choice is E19-T02.
OBJECT_STORE_IMAGE=chrislusf/seaweedfs:4.48
AZURITE_IMAGE=mcr.microsoft.com/azure-storage/azurite:3.37.0
