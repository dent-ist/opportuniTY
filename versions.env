# Single source of truth for tool and service versions.
# Read by CI (GitHub Actions), Docker Compose (--env-file) and benchmark tooling.
# Keep global.json (DOTNET_SDK) and src/Opportunity.Web/.nvmrc (NODE major) in sync; CI verifies this.
DOTNET_SDK=10.0.100
NODE=24
POSTGRES=17
OPENSEARCH=3.2.0
RABBITMQ=4.1
# CI security tooling (E01-T04). The .NET CycloneDX tool is pinned in .config/dotnet-tools.json.
GITLEAKS=8.30.1
GITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
CYCLONEDX_NPM=6.0.1
# Azurite (MIT) for the Azure Blob provider contract suite (E19-T01). SeaweedFS (below) serves the S3 suite.
AZURITE=3.37.0
# Container images used by the Testcontainers fixture library (tests/Opportunity.Testing).
# *_DIGEST pins the multi-arch index digest of the tag; bump tag and digest together.
POSTGRES_DIGEST=sha256:d74eeac9a635390a49bc21bd49fccd973de707e2a53a76ac49b552b8712ec46f
OPENSEARCH_DIGEST=sha256:23297b8d8545e129dd58c254ed08d786dc552410ba772983ad2af31048d2f04b
RABBITMQ_DIGEST=sha256:b799868f08431981001c959b04d169bff614b39c816af9c5c7acc3e031fbfc55
# Bundled S3-compatible store for Full and for tests: SeaweedFS (Apache-2.0, per Q-38), chosen in ADR-020.
SEAWEEDFS=4.48
SEAWEEDFS_DIGEST=sha256:4e61d15fd35994cb1e43e1e553dff106794841fd9a99ade2fc8c8bfce4d7872d
TOXIPROXY=2.12.0
TOXIPROXY_DIGEST=sha256:9378ed52a28bc50edc1350f936f518f31fa95f0d15917d6eb40b8e376d1a214e
# Container image scanning (E01-T05): Trivy release binary, checksum of trivy_${TRIVY}_Linux-64bit.tar.gz.
TRIVY=0.75.0
TRIVY_SHA256=c6e65abddb348e25f10549df887045629cf28cc72453cd1c63acb717316b3f3f
# Optional `observability` Compose profile (E19-T04, ADR-017). Multi-arch index digests; bump tag and digest together.
# Apache-2.0: OpenTelemetry Collector (contrib), Prometheus, Jaeger, postgres_exporter, elasticsearch_exporter.
# AGPL-3.0: Grafana, Loki - optional, unmodified external services only (Q-38, Q-42).
OTEL_COLLECTOR=0.161.0
OTEL_COLLECTOR_DIGEST=sha256:fd328de2552466ad78385e1b1289c3f2402b1c45f265b252aab1955b42845ac1
PROMETHEUS=v3.15.0
PROMETHEUS_DIGEST=sha256:efd719c99d83b060d9daefdcf00360461adf279f45ef5391f8d111892118753e
# Jaeger 2.21 removed the legacy /api query endpoints that Grafana's Jaeger datasource (13.x) still uses; keep 2.20.
JAEGER=2.20.0
JAEGER_DIGEST=sha256:46a886260e04002d8f45e213fc39063fa11a50446048fdaa64786fc0840cb9f8
LOKI=3.7.8
LOKI_DIGEST=sha256:1107dd5274e0ada47e42472b7a7e71f3b2a2fe878878108f3e2f9e51528f0193
GRAFANA=13.2.3
GRAFANA_DIGEST=sha256:b28bae15e219c998fb0e0424ed724930cc61b1f61fb404d47c862f9a23f9e572
POSTGRES_EXPORTER=v0.20.1
POSTGRES_EXPORTER_DIGEST=sha256:ac5ec343104fae0e2d84a27bb8d69b38430a11910c5382cad85d478d2bab713e
OPENSEARCH_EXPORTER=v1.11.0
OPENSEARCH_EXPORTER_DIGEST=sha256:a056739b095df4baaa076f0b31321394233da9a240eeada2623d1b028b7ee7a6
# k6 load generator for the benchmark workloads (E17-T04): grafana/k6 multi-arch index digest; bump tag and digest
# together. AGPL-3.0, run unmodified as a separate test tool and never shipped (Q-38, Q-42).
K6=2.3.0
K6_DIGEST=sha256:9c2dee7f8ed74d317e4027c06a10f169b625638189de8d4555d0b3486a5aeb34
# Developer OIDC provider for the Compose dev profile and the auth integration tests (E05-T01): Keycloak, Apache-2.0.
# Docker Hub mirror of quay.io/keycloak/keycloak; multi-arch index digest. Bump tag and digest together.
KEYCLOAK=26.7.5
