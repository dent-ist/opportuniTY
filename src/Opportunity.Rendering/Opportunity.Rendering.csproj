<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Rendering pipeline.</Description>
    <!-- PDFium is called through LibraryImport (source-generated P/Invoke over raw pointers). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!--
      E11-T02 rendering dependencies; licenses recorded in docs/architecture/rendering.md. The Linux native libraries
      do not flow to projects that reference this one (the API and other workers never render): only the hosts and
      tests that run the renderer reference them (Worker.All, Worker.Rendering, unit and integration tests).
    -->
    <PackageReference Include="bblanchon.PDFium.Linux" PrivateAssets="all" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" PrivateAssets="all" />
    <PackageReference Include="BitMiracle.LibTiff.NET" />
  </ItemGroup>

  <ItemGroup>
    <!-- E12-T04 endorsement font (SIL OFL 1.1; the license travels with it): embedded, so endorsed pages never depend on host fonts. -->
    <EmbeddedResource Include="Fonts\LiberationSans-Regular.ttf" LogicalName="Opportunity.Rendering.Fonts.LiberationSans-Regular.ttf" />
    <EmbeddedResource Include="Fonts\LICENSE-LiberationSans.txt" LogicalName="Opportunity.Rendering.Fonts.LICENSE-LiberationSans.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Opportunity.UnitTests" />
    <InternalsVisibleTo Include="Opportunity.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Opportunity.Core\Opportunity.Core.csproj" />
    <ProjectReference Include="..\..\src\Opportunity.Contracts\Opportunity.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Opportunity.Application\Opportunity.Application.csproj" />
    <!-- Page image header probe shared with OPT import (frames, DPI, color mode), so rendered frames match Page rows. -->
    <ProjectReference Include="..\..\src\Opportunity.Import\Opportunity.Import.csproj" />
  </ItemGroup>

</Project>
