{
  "name": "opportunity-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "api:generate": "ng-openapi-gen -c ng-openapi-gen.json && prettier --write --log-level warn src/app/core/api/generated",
    "api:check": "npm run api:generate && git diff --exit-code -- src/app/core/api/generated && git status --porcelain -- src/app/core/api/generated | (! grep .)",
    "budget:bundle": "node scripts/check-bundle-budgets.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/aria": "^22.2.1",
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.1",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.0",
    "ng-openapi-gen": "1.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
