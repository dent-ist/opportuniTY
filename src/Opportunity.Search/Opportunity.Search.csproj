<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>OpenSearch projection and query planning. The only project that talks to OpenSearch (ADR-019 R6).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Opportunity.IntegrationTests" />
    <InternalsVisibleTo Include="Opportunity.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Versioned projection mappings (ADR-007 R2): projection.v{G}.json, G = ProjectionGeneration. -->
    <EmbeddedResource Include="Mappings\projection.v*.json" LogicalName="Opportunity.Search.Mappings.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Opportunity.Core\Opportunity.Core.csproj" />
    <ProjectReference Include="..\..\src\Opportunity.Contracts\Opportunity.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Opportunity.Application\Opportunity.Application.csproj" />
  </ItemGroup>

</Project>
