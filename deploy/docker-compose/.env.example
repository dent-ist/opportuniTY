# Developer profile settings. Copy to .env, or run `./opportunity.sh init`, which copies this file and fills every
# empty *_PASSWORD / *_SECRET_KEY with a random value. .env is git-ignored; never commit it.
# Image versions are NOT set here: they come from ../../versions.env (the single source of truth).

# --- Secrets (required; generated by init) ----------------------------------------------------------------------
POSTGRES_PASSWORD=
OPPORTUNITY_DB_OWNER_PASSWORD=
# One database login per component (E05-T07): the API, the combined worker and the metrics exporter.
OPPORTUNITY_DB_API_PASSWORD=
OPPORTUNITY_DB_WORKER_PASSWORD=
OPPORTUNITY_DB_MONITOR_PASSWORD=
# Audit hash-chain sealer login (E14-T03; member of opportunity_audit_sealer, used by the worker and `audit` CLI only).
OPPORTUNITY_DB_AUDIT_SEALER_PASSWORD=
# The broker administrator (migrator and management UI only), then one broker user per component (E05-T07).
RABBITMQ_PASSWORD=
RABBITMQ_DISPATCHER_PASSWORD=
RABBITMQ_IMPORT_PASSWORD=
RABBITMQ_INDEX_PASSWORD=
RABBITMQ_RENDER_PASSWORD=
RABBITMQ_EXPORT_PASSWORD=
RABBITMQ_PRODUCTION_PASSWORD=
RABBITMQ_BULKCODING_PASSWORD=
# HMAC key for message envelope signing (E05-T07; at least 32 bytes). Rotation: docs/operations/message-trust.md.
ENVELOPE_HMAC_SECRET_KEY=
# Unused while the OpenSearch security plugin is disabled (developer profile); must be strong once enabled.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=
# Only used with `--profile s3` (SeaweedFS).
S3_SECRET_KEY=
# Only used with `--profile observability` (Grafana admin login; anonymous users get read-only dashboards).
GRAFANA_ADMIN_PASSWORD=
# Keycloak admin console (http://localhost:8180/admin, user `admin`). Demo users are in keycloak/opportunity-realm.json.
KEYCLOAK_ADMIN_PASSWORD=
# Client secret of the API at the dev Keycloak realm (substituted into keycloak/opportunity-realm.json at import).
OIDC_CLIENT_SECRET_KEY=
# HMAC key of the session hash in audit events (E14-T02; base64 of at least 32 bytes, init generates 44 characters).
AUDIT_SESSION_HASH_SECRET_KEY=

# --- Names ---------------------------------------------------------------------------------------------------------
# OPPORTUNITY_DB=opportunity
# OPPORTUNITY_DB_OWNER_USER=opportunity_owner
# OPPORTUNITY_DB_API_USER=opportunity_api
# OPPORTUNITY_DB_WORKER_USER=opportunity_worker
# OPPORTUNITY_DB_MONITOR_USER=opportunity_monitor
# OPPORTUNITY_DB_AUDIT_SEALER_USER=opportunity_sealer
# RABBITMQ_USER=opportunity
# S3_ACCESS_KEY=opportunity

# --- Host ports (published on OPPORTUNITY_BIND; keep 127.0.0.1: OpenSearch has no authentication here) -------------
# OPPORTUNITY_BIND=127.0.0.1
# WEB_PORT=8080
# API_PORT=8081
# POSTGRES_PORT=5432
# OPENSEARCH_PORT=9200
# RABBITMQ_PORT=5672
# RABBITMQ_MANAGEMENT_PORT=15672
# S3_PORT=8333
# KEYCLOAK_PORT=8180
# Origin the browser uses for the app; unsafe requests must send this Origin (ADR-015 D4.3).
# OPPORTUNITY_PUBLIC_ORIGIN=http://localhost:8080

# --- Resources -----------------------------------------------------------------------------------------------------
# OpenSearch JVM heap (-Xms/-Xmx). 1g fits the 8 GB minimum (Q-39); 2g is comfortable on 16 GB.
# OPENSEARCH_HEAP=1g

# --- Object store (ADR-020) ----------------------------------------------------------------------------------------
# FileSystem (default, named volume) or S3 (start with `--profile s3`, i.e. COMPOSE_PROFILES=s3).
# OPPORTUNITY_OBJECT_STORAGE=FileSystem
# COMPOSE_PROFILES=s3

# --- Object encryption (E05-T09, docs/operations/keys-and-secrets.md) ----------------------------------------------
# Envelope (default): workspace objects are encrypted with per-workspace data keys from the `keys` volume.
# ProviderSse: no client-side encryption (the S3 bucket's own encryption, or none on the filesystem store).
# OPPORTUNITY_OBJECT_ENCRYPTION=Envelope

# --- Message trust (E05-T07, docs/operations/message-trust.md) -----------------------------------------------------
# HMAC envelope signing is on in this profile; false switches it off (messages are then neither signed nor checked).
# OPPORTUNITY_ENVELOPE_SIGNING=true

# --- Import share (E08-T04) -----------------------------------------------------------------------------------------
# Host folder mounted read-only into the worker; load-file volumes (VOL001/NATIVES, TEXT, …) are copied here and the
# import profile names the volume folder inside it (paths.volumeRoot, e.g. "matter-a/VOL001").
# OPPORTUNITY_IMPORT_SHARE=./import-share

# --- Observability (ADR-017, Q-42) --------------------------------------------------------------------------------
# Telemetry is off unless OTEL_EXPORTER_OTLP_ENDPOINT is set. To run the collector + Prometheus + Jaeger + Loki +
# Grafana stack and export to it, uncomment both lines (to combine with s3: COMPOSE_PROFILES=s3,observability):
# COMPOSE_PROFILES=observability
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_METRIC_EXPORT_INTERVAL=15000
# GRAFANA_PORT=3000
# PROMETHEUS_PORT=9090
# JAEGER_UI_PORT=16686
# OTLP_GRPC_PORT=4317
# OTLP_HTTP_PORT=4318

# --- Application images --------------------------------------------------------------------------------------------
# Default: built locally from deploy/docker/*.Dockerfile as opportunity-local/opportunity-<name>:dev.
# Published images: ./opportunity.sh --images ghcr up (needs an immutable tag such as sha-1a2b3c4 or 0.1.0;
# `latest` is never published or accepted).
# OPPORTUNITY_IMAGE_PREFIX=ghcr.io/plogramer/
# OPPORTUNITY_IMAGE_TAG=sha-1a2b3c4
# Set to 0 when the builder cannot reach the Alpine mirrors (skips `apk upgrade` in the web image).
# WEB_APK_UPGRADE=1
