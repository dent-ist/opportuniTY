# Full profile settings (E19-T06). `./opportunity.sh --profile full init` copies this file to full/.env (git-ignored)
# and generates every secret as a file in full/secrets/ and the internal CA and certificates in full/tls/. No secret
# belongs in this file: secrets are Docker secrets (ADR-015 D10.1). Image versions come from ../../versions.env.

# --- Required: the installation's address and identity provider ---------------------------------------------------
# Host name browsers use; the web certificate in full/tls/web is issued for it (replace it with your own certificate
# by overwriting full/tls/web/server.crt and server.key). The public origin must match what browsers send as Origin.
OPPORTUNITY_HOSTNAME=opportunity.internal
OPPORTUNITY_PUBLIC_ORIGIN=https://opportunity.internal
# OIDC provider of the installation (ADR-015 D3). The client secret goes into full/secrets/oidc-client-secret.
OIDC_AUTHORITY=https://idp.example.org/realms/opportunity
OIDC_CLIENT_ID=opportunity-web

# --- Published port (the only one) ---------------------------------------------------------------------------------
# OPPORTUNITY_BIND=0.0.0.0
# HTTPS_PORT=443

# --- Scale (also `--scale <service>=N` on the command line) ---------------------------------------------------------
# API_REPLICAS=2
# INDEX_WORKERS=2
# BULKCODING_WORKERS=1
# S3_GATEWAYS=2

# --- Resources -----------------------------------------------------------------------------------------------------
# OPENSEARCH_HEAP=2g          # per node; about half of OPENSEARCH_MEMORY
# OPENSEARCH_MEMORY=4g
# POSTGRES_MEMORY=4g
# POSTGRES_SHARED_BUFFERS=1GB
# POSTGRES_MAX_CONNECTIONS=400
# RABBITMQ_MEMORY=1g
# API_MEMORY=2g
# WORKER_MEMORY=2g

# --- Replication and storage ---------------------------------------------------------------------------------------
# '' (default) = asynchronous replica; 'FIRST 1 (postgres_replica)' = synchronous (first start of the primary only).
# POSTGRES_SYNC_STANDBY=
# SeaweedFS default replication: 010 = one copy on each of the two volume-server racks.
# SEAWEEDFS_REPLICATION=010

# --- Keys (ADR-016 §5.1) -------------------------------------------------------------------------------------------
# Set to false once the key ring exists and is backed up, so a missing key directory fails loudly after a restore.
# OPPORTUNITY_KEYS_CREATE_MISSING=true

# --- Observability (`COMPOSE_PROFILES=full,observability`) ----------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# GRAFANA_PORT=3000
# PROMETHEUS_PORT=9090
# JAEGER_UI_PORT=16686

# --- Application images ----------------------------------------------------------------------------------------------
# Default: the locally built opportunity-local/opportunity-<name>:dev (`./opportunity.sh --profile full build`).
# Published images: ./opportunity.sh --images ghcr --profile full up (immutable tag required).
# OPPORTUNITY_IMAGE_PREFIX=ghcr.io/plogramer/
# OPPORTUNITY_IMAGE_TAG=0.1.0
# OPPORTUNITY_IMPORT_SHARE=./import-share
