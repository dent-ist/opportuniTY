<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Company>opportuniTY contributors</Company>
    <Product>opportuniTY</Product>
  </PropertyGroup>
  <!--
    E06-T05: IFaultInjector failpoints exist only in test builds. `dotnet publish -c Release` (every shipped artifact,
    see deploy/docker/dotnet.Dockerfile) compiles them out; -p:OpportunityFailpoints=false forces that anywhere.
  -->
  <PropertyGroup>
    <OpportunityFailpoints Condition="'$(OpportunityFailpoints)' == '' and '$(Configuration)' == 'Release' and '$(_IsPublishing)' == 'true'">false</OpportunityFailpoints>
    <OpportunityFailpoints Condition="'$(OpportunityFailpoints)' == ''">true</OpportunityFailpoints>
    <DefineConstants Condition="'$(OpportunityFailpoints)' == 'true'">$(DefineConstants);OPPORTUNITY_FAILPOINTS</DefineConstants>
  </PropertyGroup>
</Project>
