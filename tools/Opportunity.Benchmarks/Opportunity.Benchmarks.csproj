<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>opportunity-bench</AssemblyName>
    <RootNamespace>Opportunity.Benchmarks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kestrel for the fake API (`stub-api`) the k6 workloads are validated against until the M1 API exists. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="HdrHistogram" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Opportunity.Core\Opportunity.Core.csproj" />
    <ProjectReference Include="..\..\src\Opportunity.Contracts\Opportunity.Contracts.csproj" />
    <!-- Query sets are generated from (and counted against) the regenerated corpus (E17-T04). -->
    <ProjectReference Include="..\Opportunity.DataGenerator.Corpus\Opportunity.DataGenerator.Corpus.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Schemas are embedded so the validator never depends on the working directory. -->
    <EmbeddedResource Include="schema\*.schema.json" LogicalName="schema/%(Filename)%(Extension)" />
    <None Include="gates.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
